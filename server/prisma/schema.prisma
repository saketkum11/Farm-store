// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  fullName String?
  email String @unique
  password String 
  carts cart[]
  wishList wishList[]
}

model Product {
   id Int @id @default(autoincrement())
   title String
   image String
   price Int
   description String
   inStock Boolean @default(true)
   rating Int
   category String?
   discount Int
   cart cart @relation(fields: [cartId], references: [id])
   cartId Int @unique
   wishList wishList @relation(fields: [wishListId],references: [id])
   wishListId Int @unique
}

model categorie {
  id Int @id @default(autoincrement())
  title String
  thumbnail String?
  description String? 
}
model cart {
   id Int @id @default(autoincrement())
    title String
   user User @relation(fields: [userId],references: [id])
   userId Int @unique
   products Product[]
}
model wishList {
  id Int @id @default(autoincrement())
  title String
  user User @relation(fields: [userId],references: [id])
  userId Int @unique
  products Product[]
}